# Copy to .env.local and fill in your own values. .env.local is git-ignored and must never be committed.
#   cp .env.example .env.local
# Scripts in scripts/ load .env.local automatically; values already exported in your shell take precedence.

# Named profile in ~/.aws/config (credentials stay in the AWS credential chain, never in this file)
PROFILE=<profile>
REGION=us-east-1

# CloudFormation stack and resource-name prefix
STACK=kirocrew-devops-discovery-demo

# DevOps Agent Space ID: aws devops-agent list-agent-spaces --region "$REGION" --profile "$PROFILE"
SPACE_ID=<agent-space-id>

# Versioned boto3 layer ARN in your own account (see KIROCREW_DEMO_GUIDE.md, step 1)
LAYER_ARN=arn:aws:lambda:<region>:<account-id>:layer:boto3-devops-agent:<version>
